// Persica Language Prelude
// Automatically available in every Persica program without needing import
// Self-hosted in 100% pure Persica

struct Pair {
    any first;
    any second;
}

struct Result {
    bool ok;
    any value;
    string error;
}

struct Option {
    bool has_value;
    any value;
}

def Result ok(any value) {
    return Result(true, value, "");
}

def Result err(string message) {
    return Result(false, false, message);
}

def Option some(any value) {
    return Option(true, value);
}

def Option none() {
    return Option(false, false);
}

class Stack {
    any[] items;

    def void push(any item) {
        this.items = append(this.items, item);
    }

    def any pop() {
        if len(this.items) == 0 {
            return false;
        }
        int last_idx = len(this.items) - 1;
        any item = this.items[last_idx];
        this.items = slice(this.items, 0, last_idx);
        return item;
    }

    def any peek() {
        if len(this.items) == 0 {
            return false;
        }
        return this.items[len(this.items) - 1];
    }

    def bool is_empty() {
        return len(this.items) == 0;
    }

    def int size() {
        return len(this.items);
    }

    def void clear() {
        this.items = [];
    }

    def any[] to_array() {
        return this.items;
    }
}

class Queue {
    any[] items;

    def void enqueue(any item) {
        this.items = append(this.items, item);
    }

    def any dequeue() {
        if len(this.items) == 0 {
            return false;
        }
        any item = this.items[0];
        this.items = slice(this.items, 1, len(this.items));
        return item;
    }

    def any peek() {
        if len(this.items) == 0 {
            return false;
        }
        return this.items[0];
    }

    def bool is_empty() {
        return len(this.items) == 0;
    }

    def int size() {
        return len(this.items);
    }

    def void clear() {
        this.items = [];
    }

    def any[] to_array() {
        return this.items;
    }
}

class Set {
    dict data;

    def void add(any item) {
        dict d = this.data;
        d[item] = true;
        this.data = d;
    }

    def bool contains(any item) {
        return contains_key(this.data, item);
    }

    def void remove(any item) {
        this.data = remove_key(this.data, item);
    }

    def int size() {
        return len(this.data);
    }

    def any[] to_array() {
        return keys(this.data);
    }

    def void clear() {
        this.data = {};
    }
}

class StringBuilder {
    string[] parts;

    def void append_str(string text) {
        this.parts = append(this.parts, text);
    }

    def void append_line(string text) {
        this.parts = append(this.parts, text + "\n");
    }

    def string to_str() {
        return join("", this.parts);
    }

    def int length() {
        return len(this.to_str());
    }

    def void clear() {
        this.parts = [];
    }
}

def any[][] zip(any[] a, any[] b) {
    int count = len(a);
    if len(b) < count {
        count = len(b);
    }
    any[][] result = [];
    for (int i = 0; i < count; i++) {
        any[] pair = [a[i], b[i]];
        result = append(result, pair);
    }
    return result;
}

def any[][] chunks(any[] arr, int size) {
    any[][] result = [];
    if size <= 0 || len(arr) == 0 {
        return result;
    }
    int i = 0;
    while i < len(arr) {
        int end_idx = i + size;
        if end_idx > len(arr) {
            end_idx = len(arr);
        }
        result = append(result, slice(arr, i, end_idx));
        i += size;
    }
    return result;
}

def any[] flatten(any[][] arr) {
    any[] result = [];
    for sub in arr {
        for item in sub {
            result = append(result, item);
        }
    }
    return result;
}

def int binary_search(int[] arr, int target) {
    int low = 0;
    int high = len(arr) - 1;
    while low <= high {
        int mid = low + (high - low) / 2;
        if arr[mid] == target {
            return mid;
        }
        if arr[mid] < target {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    return -1;
}

def int linear_search(any[] arr, any target) {
    for (int i = 0; i < len(arr); i++) {
        if arr[i] == target {
            return i;
        }
    }
    return -1;
}

def any[] fill(int count, any value) {
    any[] result = [];
    for (int i = 0; i < count; i++) {
        result = append(result, value);
    }
    return result;
}

def string repeat_str(string s, int count) {
    string result = "";
    for (int i = 0; i < count; i++) {
        result = result + s;
    }
    return result;
}

def string center(string text, int width, string pad_char) {
    int total_pad = width - len(text);
    if total_pad <= 0 {
        return text;
    }
    int left_pad = total_pad / 2;
    int right_pad = total_pad - left_pad;
    return pad_left(text, len(text) + left_pad, pad_char) + repeat_str(pad_char, right_pad);
}

def string truncate(string text, int max_len, string suffix) {
    if len(text) <= max_len {
        return text;
    }
    int keep = max_len - len(suffix);
    if keep <= 0 {
        return suffix;
    }
    return slice(text, 0, keep) + suffix;
}

def float lerp(float a, float b, float t) {
    return a + (b - a) * t;
}

def float deg_to_rad(float deg) {
    return deg * 3.141592653589793 / 180.0;
}

def float rad_to_deg(float rad) {
    return rad * 180.0 / 3.141592653589793;
}

def float distance_2d(float x1, float y1, float x2, float y2) {
    float dx = x2 - x1;
    float dy = y2 - y1;
    return sqrt(dx * dx + dy * dy);
}
